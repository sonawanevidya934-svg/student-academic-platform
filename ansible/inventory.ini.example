# Student Academic Platform - example inventory (placeholders only).
# Copy to inventory.ini and fill in your EC2 details after `terraform apply`:
#   cp ansible/inventory.ini.example ansible/inventory.ini
# Get the real IP/DNS from: terraform -chdir=terraform output ec2_public_ip
# Never commit inventory.ini with real IPs, users, or key paths if it contains secrets.
# inventory.ini (local, git-tracked) stays as localhost for safe local validation.
[app]
# Local validation (default):
localhost ansible_connection=local
# EC2 target (uncomment and fill placeholders after terraform apply):
# app-server ansible_host=<EC2_PUBLIC_IP_OR_DNS> ansible_user=ubuntu ansible_ssh_private_key_file=<PATH_TO_YOUR_KEY_PEM>
